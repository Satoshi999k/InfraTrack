# MySQL-compatible database. Set DB_SSL=true for managed providers such as TiDB Cloud.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=infratrack
DB_SSL=false

# Optional API URL override. Production defaults to the same origin; local
# development defaults to http://localhost:3001/api.
# VITE_API_URL=

# Durable advisory media storage. Configure an unsigned upload preset in
# Cloudinary so Vercel does not lose files written to its temporary filesystem.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=

# Flutter mobile builds configure their API URL separately:
# Android emulator: --dart-define=API_BASE_URL=http://10.0.2.2:3001/api
# Physical device: use the LAN address of this server (for example,
# http://192.168.1.10:3001/api). Release builds use the production URL in
# infratrack_mobile/lib/api_service.dart unless API_BASE_URL is overridden.

# Login attempts allowed per IP during a 15-minute window (default: 10).
# Raise temporarily for testing; restore to 10 for production.
LOGIN_MAX_ATTEMPTS=10

# Brevo transactional email. Verify this sender address in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=InfraTrack
# Optional: public HTTPS URL of the InfraTrack sign-in page for email buttons.
APP_PUBLIC_URL=
# Optional: publicly accessible HTTPS PNG/JPG logo URL for the email header.
BREVO_LOGO_URL=
